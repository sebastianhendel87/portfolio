{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|mov|webp|png|jpg|jpeg|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/tonscan$", "dest": "/tonscan.html" },
    { "src": "^/dune$", "dest": "/dune.html" },
    { "src": "^/spotify$", "dest": "/spotify.html" },
    { "src": "^/carbo-culture$", "dest": "/carbo-culture.html" },
    { "src": "^/work$", "dest": "/work.html" }
  ]
}


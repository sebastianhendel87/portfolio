{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(mp4|mov|webp|png|jpg|jpeg|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tonscan", "destination": "/tonscan.html" },
    { "source": "/dune", "destination": "/dune.html" },
    { "source": "/spotify", "destination": "/spotify.html" },
    { "source": "/carbo-culture", "destination": "/carbo-culture.html" },
    { "source": "/work", "destination": "/work.html" }
  ]
}

